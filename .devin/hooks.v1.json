{
  "PreToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "/opt/homebrew/bin/rtk hook claude",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^(exec|get_output|write_to_process|kill_shell|read|notebook_read|grep|webfetch|web_search|run_subagent|read_subagent|mcp_.*)$",
      "hooks": [
        {
          "type": "command",
          "command": "/usr/bin/python3 $HOME/.local/share/rtk-devin/rtk-posthook.py",
          "timeout": 10
        }
      ]
    }
  ]
}
